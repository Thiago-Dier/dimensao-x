-- =========================================================
-- CONSULTAS DE DEMONSTRACAO DOS COMANDOS DA AULA
-- =========================================================

-- 1. COUNT(): conta quantos jogadores existem.
SELECT COUNT(*) AS total_jogadores
FROM jogadores;

-- 2. MAX(): encontra o maior numero de gols.
SELECT MAX(gols) AS maior_numero_gols
FROM jogadores;

-- 3. MIN(): encontra o menor numero de gols.
SELECT MIN(gols) AS menor_numero_gols
FROM jogadores;

-- 4. SUM(): soma os valores de mercado (em milhoes de euros).
SELECT SUM(valor_milhoes) AS valor_total_milhoes
FROM jogadores;

-- 5. AVG(): calcula a media de gols.
SELECT AVG(gols) AS media_gols
FROM jogadores;

-- 6. DISTINCT: lista os clubes sem repeticao.
SELECT DISTINCT clube
FROM jogadores;
